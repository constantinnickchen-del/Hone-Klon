<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ConstiBoost</RootNamespace>
    <AssemblyName>ConstiBoost</AssemblyName>
    <ApplicationManifest>App\app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\ConstiBoost.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <Product>ConstiBoost</Product>
    <Description>Local, transparent and reversible Windows gaming performance optimizer.</Description>
    <Copyright>ConstiBoost</Copyright>
    <!-- Allows building (not running) on non-Windows machines, e.g. CI. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <InvariantGlobalization>false</InvariantGlobalization>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App\App.xaml" />
    <Page Remove="App\App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\ConstiBoost.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

</Project>
