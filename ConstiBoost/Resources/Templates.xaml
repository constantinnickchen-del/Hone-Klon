<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:ConstiBoost.UI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ConstiBoost;component/Resources/Styles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <ui:BoolToVisibilityConverter x:Key="BoolToVis" />
    <ui:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
    <ui:NullToVisibilityConverter x:Key="NullToVis" />
    <ui:NullToVisibilityConverter x:Key="InvNullToVis" Invert="True" />
    <ui:InverseBoolConverter x:Key="InverseBool" />
    <ui:StatusToBrushConverter x:Key="StatusBrush" />
    <ui:StatusToBrushConverter x:Key="StatusSoftBrush" Soft="True" />

    <!-- 🎮 GAMING MODE card (shared by Dashboard and Fortnite) -->
    <DataTemplate x:Key="GamingModeCard">
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding ToggleCommand}" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BadSoftBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource BadBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BadBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding ButtonText}" />
                    </Button>
                    <TextBlock DockPanel.Dock="Left" Text="🎮" FontSize="26" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <StackPanel>
                        <TextBlock Text="GAMING MODE" Style="{StaticResource Text.H2}" />
                        <TextBlock Text="{Binding StatusText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
                <TextBlock Style="{StaticResource Text.Body}" Margin="0,12,0,0"
                           Text="Temporary session: Game Mode ON, performance power mode, selected apps closed and background apps lowered in priority. Stopping Gaming Mode restores everything that can be restored (and reopens closed apps if enabled)." />
                <StackPanel Visibility="{Binding IsActive, Converter={StaticResource InvBoolToVis}}">
                    <WrapPanel Margin="0,14,0,0">
                        <CheckBox Content="Lower priority of browsers/launchers" IsChecked="{Binding LowerPriority}" Margin="0,0,24,8" />
                        <CheckBox Content="Reopen closed apps afterwards" IsChecked="{Binding RelaunchClosedApps}" Margin="0,0,24,8" />
                        <Button Style="{StaticResource GhostButton}" Content="Choose apps to close…" Command="{Binding LoadAppsCommand}" Padding="0,0,0,8" />
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding Apps}" Visibility="{Binding ShowApps, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,0,6" Padding="12,8">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding RamText}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                        <CheckBox IsChecked="{Binding IsSelected}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Body}" FontSize="11.5" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Section header -->
    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.H2}">
        <Setter Property="Margin" Value="0,10,0,12" />
    </Style>
</ResourceDictionary>
