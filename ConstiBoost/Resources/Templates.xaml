<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:ConstiBoost.UI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ConstiBoost;component/Resources/Styles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <ui:BoolToVisibilityConverter x:Key="BoolToVis" />
    <ui:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
    <ui:NullToVisibilityConverter x:Key="NullToVis" />
    <ui:NullToVisibilityConverter x:Key="InvNullToVis" Invert="True" />
    <ui:InverseBoolConverter x:Key="InverseBool" />
    <ui:StatusToBrushConverter x:Key="StatusBrush" />
    <ui:StatusToBrushConverter x:Key="StatusSoftBrush" Soft="True" />

    <!-- 🎮 GAMING MODE card (shared by Dashboard and Fortnite) -->
    <DataTemplate x:Key="GamingModeCard">
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding ToggleCommand}" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BadSoftBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource BadBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BadBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding ButtonText}" />
                    </Button>
                    <TextBlock DockPanel.Dock="Left" Text="🎮" FontSize="26" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <StackPanel>
                        <TextBlock Text="GAMING MODE" Style="{StaticResource Text.H2}" />
                        <TextBlock Text="{Binding StatusText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
                <TextBlock Style="{StaticResource Text.Body}" Margin="0,12,0,0"
                           Text="Temporary session: Game Mode ON, power settings for the chosen profile, selected apps closed and background apps lowered in priority. Stopping Gaming Mode restores everything that can be restored (and reopens closed apps if enabled)." />
                <TextBlock Text="{Binding ActiveProfileText}" Style="{StaticResource Text.H3}" Foreground="{DynamicResource GoodBrush}" Margin="0,8,0,0"
                           Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                <StackPanel Visibility="{Binding IsActive, Converter={StaticResource InvBoolToVis}}">
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <RadioButton Style="{StaticResource Segment}" GroupName="GamingProfile" IsChecked="{Binding IsMaxFps}">
                            <StackPanel>
                                <TextBlock Text="MAX FPS" FontWeight="Bold" />
                                <TextBlock Text="max performance · warmer" FontSize="10.5" Opacity="0.75" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Segment}" GroupName="GamingProfile" IsChecked="{Binding IsBalanced}">
                            <StackPanel>
                                <TextBlock Text="BALANCED" FontWeight="Bold" />
                                <TextBlock Text="good FPS · cooler" FontSize="10.5" Opacity="0.75" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Segment}" GroupName="GamingProfile" IsChecked="{Binding IsCool}">
                            <StackPanel>
                                <TextBlock Text="COOL" FontWeight="Bold" />
                                <TextBlock Text="less heat · less FPS" FontSize="10.5" Opacity="0.75" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                    <TextBlock Text="{Binding ProfileDescription}" Style="{StaticResource Text.Body}" Margin="0,8,0,0" />
                    <WrapPanel Margin="0,14,0,0">
                        <CheckBox Content="Lower priority of browsers/launchers" IsChecked="{Binding LowerPriority}" Margin="0,0,24,8" />
                        <CheckBox Content="Reopen closed apps afterwards" IsChecked="{Binding RelaunchClosedApps}" Margin="0,0,24,8" />
                        <CheckBox IsChecked="{Binding CapFortniteFps}" Margin="0,0,24,8"
                                  ToolTip="An FPS cap is one of the most effective ways to reduce gaming heat. Only applied while Fortnite is closed; the previous value is restored when Gaming Mode stops.">
                            <TextBlock Text="{Binding FortniteFpsCap, StringFormat='Cap Fortnite at {0} FPS'}" />
                        </CheckBox>
                        <Button Style="{StaticResource GhostButton}" Content="Choose apps to close…" Command="{Binding LoadAppsCommand}" Padding="0,0,0,8" />
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding Apps}" Visibility="{Binding ShowApps, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,0,6" Padding="12,8">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding RamText}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                        <CheckBox IsChecked="{Binding IsSelected}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Body}" FontSize="11.5" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Optimization card (Optimizer + Boost Lab) -->
    <DataTemplate x:Key="OptimizationCard">
        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}" VerticalAlignment="Top" Margin="0,8,14,0" />
                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H3}" FontSize="15" VerticalAlignment="Center" />
                        <Border Style="{StaticResource Pill}" Margin="10,0,0,0" Background="{Binding StatusText, Converter={StaticResource StatusSoftBrush}}">
                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusText, Converter={StaticResource StatusBrush}}" />
                        </Border>
                        <Border Style="{StaticResource Pill}" Margin="6,0,0,0" Background="{DynamicResource InputBrush}">
                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <Border Style="{StaticResource Pill}" Margin="6,0,0,0" Background="{DynamicResource WarnSoftBrush}"
                                Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Admin (UAC)" FontSize="11" Foreground="{DynamicResource WarnBrush}" />
                        </Border>
                    </StackPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CURRENT" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="{Binding CurrentState}" Style="{StaticResource Text.Value}" FontSize="13.5" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,12,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="RECOMMENDED" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="{Binding RecommendedState}" Style="{StaticResource Text.Value}" FontSize="13.5" TextWrapping="Wrap" TextTrimming="None"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Body}">
                        <Run Text="Why: " FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" /><Run Text="{Binding Reason, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding UnavailableReason}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource WarnBrush}" Margin="0,6,0,0"
                               Visibility="{Binding UnavailableReason, Converter={StaticResource NullToVis}}" />

                    <Expander Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                        <Expander.Header>
                            <TextBlock Text="What does it do? · Possible downsides" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="{Binding WhatItDoes}" Style="{StaticResource Text.Body}" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Body}">
                                <Run Text="Downsides: " FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}" /><Run Text="{Binding Downsides, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding ReversibleText}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Expander>

                    <TextBlock Text="{Binding ResultText}" Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{Binding ResultSuccess, Converter={StaticResource StatusBrush}}"
                               Visibility="{Binding ResultText, Converter={StaticResource NullToVis}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="12,0,0,0" HorizontalAlignment="Right">
                    <TextBlock Text="IMPACT" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding ImpactText}" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,2,0,0"
                               Foreground="{Binding Impact, Converter={StaticResource StatusBrush}}" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Section header -->
    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.H2}">
        <Setter Property="Margin" Value="0,10,0,12" />
    </Style>
</ResourceDictionary>
