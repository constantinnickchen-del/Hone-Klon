<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Default (Dark) theme. ThemeService replaces these brushes at runtime for theme/accent changes. -->
    <Color x:Key="AccentColor">#00C2FF</Color>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0C0F" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#0F1014" />
    <SolidColorBrush x:Key="CardBrush" Color="#16171C" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#1C1D23" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#24262D" />
    <SolidColorBrush x:Key="InputBrush" Color="#1E1F25" />
    <SolidColorBrush x:Key="AccentBrush" Color="#00C2FF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2600C2FF" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#5500C2FF" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#0B0C0F" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F3F5" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3A9B4" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6B717C" />

    <SolidColorBrush x:Key="GoodBrush" Color="#3DDC84" />
    <SolidColorBrush x:Key="WarnBrush" Color="#FFB020" />
    <SolidColorBrush x:Key="BadBrush" Color="#FF5C5C" />
    <SolidColorBrush x:Key="NeutralBrush" Color="#6B717C" />
    <SolidColorBrush x:Key="GoodSoftBrush" Color="#223DDC84" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#22FFB020" />
    <SolidColorBrush x:Key="BadSoftBrush" Color="#22FF5C5C" />

    <SolidColorBrush x:Key="ChartCpuBrush" Color="#00C2FF" />
    <SolidColorBrush x:Key="ChartGpuBrush" Color="#7C5CFF" />
    <SolidColorBrush x:Key="ChartRamBrush" Color="#2EE59D" />

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI</FontFamily>
</ResourceDictionary>
