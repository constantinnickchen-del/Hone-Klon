<UserControl x:Class="ConstiBoost.Views.CleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,32">
            <DockPanel Margin="0,0,0,20">
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="SCAN" Command="{Binding ScanCommand}" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="Cleaner" Style="{StaticResource Text.H1}" />
                    <TextBlock Text="Only safe cache and temp folders. Personal files are never touched." Style="{StaticResource Text.Body}" />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="26">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource HeroButton}" Content="CLEAN" Command="{Binding CleanCommand}" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="{Binding EstimateText}" Style="{StaticResource Text.H2}" FontSize="20" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Body}" Margin="0,4,0,0" />
                        <ProgressBar IsIndeterminate="True" Margin="0,10,40,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding BrowserWarning}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource WarnBrush}" Margin="0,8,0,0"
                                   Visibility="{Binding BrowserWarning, Converter={StaticResource NullToVis}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource Text.H2}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding FileCount, StringFormat={}{0} files}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                                </StackPanel>
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,14,0" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H3}" FontSize="15" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Body}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Body}" FontSize="11.5" Foreground="{DynamicResource WarnBrush}" Margin="0,4,0,0"
                                               Visibility="{Binding Note, Converter={StaticResource NullToVis}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Visibility="{Binding Results, Converter={StaticResource NullToVis}}">
                <StackPanel>
                    <TextBlock Text="RESULT" Style="{StaticResource Text.Caption}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource InnerCard}" Margin="0,12,0,0">
                <TextBlock Style="{StaticResource Text.Body}" FontSize="12"
                           Text="Never deleted: Documents, Pictures, Desktop, Downloads, Music, Videos, OneDrive, game saves, browser cookies, passwords and history. Symbolic links / junctions are never followed. Files in use are skipped." />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
