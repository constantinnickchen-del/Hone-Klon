<Window x:Class="ConstiBoost.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height" MaxHeight="720"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{DynamicResource UiFont}">
    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Margin="16" Padding="26">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.6" Color="Black" />
        </Border.Effect>
        <DockPanel>
            <TextBlock x:Name="TitleText" DockPanel.Dock="Top" Style="{StaticResource Text.H2}" FontSize="20" TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText" DockPanel.Dock="Top" Style="{StaticResource Text.Body}" Margin="0,10,0,0" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="CANCEL" Click="Cancel_Click" Margin="0,0,10,0" IsCancel="True" />
                <Button x:Name="ConfirmButton" Style="{StaticResource AccentButton}" Click="Confirm_Click" IsDefault="True" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="380" Margin="0,14,0,0" x:Name="DetailsScroller">
                <ItemsControl x:Name="DetailsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource InnerCard}" Margin="0,0,0,6" Padding="12,8">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
