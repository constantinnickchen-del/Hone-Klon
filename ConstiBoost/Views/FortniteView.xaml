<UserControl x:Class="ConstiBoost.Views.FortniteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,32">
            <DockPanel Margin="0,0,0,20">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Content="REFRESH" Command="{Binding RefreshCommand}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource AccentButton}" Content="▶ LAUNCH FORTNITE" Command="{Binding LaunchCommand}"
                            IsEnabled="{Binding IsInstalled}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="🎮 Fortnite Boost" Style="{StaticResource Text.H1}" />
                    <TextBlock Text="Presets for Fortnite's own settings file – transparent, backed up, no FPS promises." Style="{StaticResource Text.Body}" />
                </StackPanel>
            </DockPanel>

            <!-- Install + device -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource Pill}"
                                    Background="{Binding IsInstalled, Converter={StaticResource StatusSoftBrush}}">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding IsInstalled, Converter={StaticResource StatusBrush}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="NOT FOUND" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                    <Setter Property="Text" Value="DETECTED" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="INSTALLATION" Style="{StaticResource Text.Caption}" />
                        </DockPanel>
                        <TextBlock Text="{Binding InstallPath}" Style="{StaticResource Text.Value}" Margin="0,10,0,2" TextWrapping="Wrap" TextTrimming="None" />
                        <TextBlock Text="{Binding InstallSource}" Style="{StaticResource Text.Body}" FontSize="12" />
                        <TextBlock Text="{Binding Version, StringFormat='Version: {0}'}" Style="{StaticResource Text.Body}" FontSize="12" />
                        <TextBlock Text="{Binding ConfigStatus}" Style="{StaticResource Text.Body}" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding ConfigPath}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ProcessText}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="RECOMMENDATION FOR YOUR PC" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="We detected a low-power integrated-GPU system." Style="{StaticResource Text.H3}" Margin="0,10,0,0"
                                   Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsLowEnd, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding DeviceRecommendation}" Style="{StaticResource Text.Body}" Margin="0,8,0,0" />
                        <UniformGrid Columns="3" Margin="0,12,0,0" Visibility="{Binding IsLowEnd, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource InnerCard}" Margin="0,0,6,6"><TextBlock Text="PERFORMANCE MODE" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" /></Border>
                            <Border Style="{StaticResource InnerCard}" Margin="0,0,6,6"><TextBlock Text="LOW SETTINGS" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" /></Border>
                            <Border Style="{StaticResource InnerCard}" Margin="0,0,0,6"><TextBlock Text="3D RES 70–85 %" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" /></Border>
                            <Border Style="{StaticResource InnerCard}" Margin="0,0,6,0"><TextBlock Text="VSYNC OFF" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" /></Border>
                            <Border Style="{StaticResource InnerCard}" Margin="0,0,6,0"><TextBlock Text="MOTION BLUR OFF" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" /></Border>
                            <Border Style="{StaticResource InnerCard}"><TextBlock Text="SHADOWS OFF" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" /></Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Presets -->
            <TextBlock Text="FPS Presets" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding Presets}" Margin="-6,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="6,0" Cursor="Hand" Command="{Binding DataContext.SelectPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Card" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H2}" FontSize="19" />
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Body}" Margin="0,4,0,12" />
                                            <ItemsControl ItemsSource="{Binding Preset.Display}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,2">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" FontSize="12" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,12" />
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ImpactText}" FontWeight="Bold"
                                                           Foreground="{Binding Impact, Converter={StaticResource StatusBrush}}" />
                                                <TextBlock Text="Estimated impact:" Style="{StaticResource Text.Body}" FontSize="12" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource Text.Body}" FontSize="11.5" Margin="0,8,0,0" Foreground="{DynamicResource TextMutedBrush}"
                       Text="Estimated impact = how much the preset lowers your current settings (LOW / MEDIUM / HIGH). It is not an FPS number – real FPS depend on map, scene, drivers and hardware." />

            <!-- Preset options -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="PRESET OPTIONS" Style="{StaticResource Text.Caption}" />
                    <DockPanel Margin="0,12,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Resolution, StringFormat={}{0} %}" Style="{StaticResource Text.H2}" Width="70" TextAlignment="Right" />
                        <TextBlock Text="3D Resolution" Style="{StaticResource Text.H3}" VerticalAlignment="Center" Width="140" />
                        <Slider Minimum="50" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Resolution}" Margin="10,0" />
                    </DockPanel>
                    <TextBlock Text="{Binding ResolutionHint}" Style="{StaticResource Text.Body}" Margin="150,2,0,0" />
                    <WrapPanel Margin="0,16,0,0">
                        <CheckBox Content="VSync OFF" IsChecked="{Binding DisableVSync}" Margin="0,0,28,8"
                                  ToolTip="VSync syncs frames to the monitor: no tearing, but more input lag and FPS drops to 30 when below 60. OFF is recommended for competitive play." />
                        <CheckBox Content="Motion Blur OFF" IsChecked="{Binding DisableMotionBlur}" Margin="0,0,28,8"
                                  ToolTip="Motion blur smears the image when turning. Off = clearer image and slightly less GPU work." />
                        <CheckBox Content="Fullscreen" IsChecked="{Binding Fullscreen}" Margin="0,0,28,8"
                                  ToolTip="Exclusive fullscreen usually gives the lowest input lag and most stable frame times." />
                        <CheckBox IsChecked="{Binding CapFps}" Margin="0,0,28,8"
                                  ToolTip="A frame cap at your display refresh rate gives more even frame times and lower temperatures on laptops.">
                            <TextBlock Text="{Binding FpsCap, StringFormat='Cap FPS at {0} (display refresh rate)'}" />
                        </CheckBox>
                    </WrapPanel>
                    <DockPanel Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource HeroButton}" Content="APPLY PRESET" Command="{Binding ApplyPresetCommand}" />
                        <TextBlock Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,0,20,0"
                                   Text="Fortnite must be closed. GameUserSettings.ini is backed up first and can be restored on the Backups page. Only settings that already exist in your file are changed." />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding MissingKeys}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='Not in your settings file – set it in-game: {0}'}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource WarnBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Current settings -->
            <TextBlock Text="Your current Fortnite settings" Style="{StaticResource SectionTitle}" Margin="0,22,0,12" />
            <Border Style="{StaticResource Card}">
                <UniformGrid Columns="5">
                    <StackPanel Margin="0,4"><TextBlock Text="Rendering Mode" Style="{StaticResource Text.Body}" /><TextBlock Text="{Binding CurrentRenderingMode}" Style="{StaticResource Text.Value}" /></StackPanel>
                    <StackPanel Margin="0,4"><TextBlock Text="3D Resolution" Style="{StaticResource Text.Body}" /><TextBlock Text="{Binding Current3DResolution}" Style="{StaticResource Text.Value}" /></StackPanel>
                    <StackPanel Margin="0,4"><TextBlock Text="View Distance" Style="{StaticResource Text.Body}" /><TextBlock Text="{Binding CurrentViewDistance}" Style="{StaticResource Text.Value}" /></StackPanel>
                    <StackPanel Margin="0,4"><TextBlock Text="Shadows" Style="{StaticResource Text.Body}" /><TextBlock Text="{Binding CurrentShadows}" Style="{StaticResource Text.Value}" /></StackPanel>
                    <StackPanel Margin="0,4"><TextBlock Text="Textures" Style="{StaticResource Text.Body}" /><TextBlock Text="{Binding CurrentTextures}" Style="{StaticResource Text.Value}" /></StackPanel>
                    <StackPanel Margin="0,4"><TextBlock Text="Effects" Style="{StaticResource Text.Body}" /><TextBlock Text="{Binding CurrentEffects}" Style="{StaticResource Text.Value}" /></StackPanel>
                    <StackPanel Margin="0,4"><TextBlock Text="VSync" Style="{StaticResource Text.Body}" /><TextBlock Text="{Binding CurrentVSync}" Style="{StaticResource Text.Value}" /></StackPanel>
                    <StackPanel Margin="0,4"><TextBlock Text="Motion Blur" Style="{StaticResource Text.Body}" /><TextBlock Text="{Binding CurrentMotionBlur}" Style="{StaticResource Text.Value}" /></StackPanel>
                    <StackPanel Margin="0,4"><TextBlock Text="Frame Rate Limit" Style="{StaticResource Text.Body}" /><TextBlock Text="{Binding CurrentFrameLimit}" Style="{StaticResource Text.Value}" /></StackPanel>
                    <StackPanel Margin="0,4"><TextBlock Text="Window Mode" Style="{StaticResource Text.Body}" /><TextBlock Text="{Binding CurrentWindowMode}" Style="{StaticResource Text.Value}" /></StackPanel>
                </UniformGrid>
            </Border>

            <!-- Explanations -->
            <TextBlock Text="Explained" Style="{StaticResource SectionTitle}" Margin="0,22,0,12" />
            <UniformGrid Columns="2" Margin="-6,0">
                <Border Style="{StaticResource Card}" Margin="6,0,6,12">
                    <StackPanel>
                        <TextBlock Text="Performance Mode" Style="{StaticResource Text.H3}" />
                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0"
                                   Text="A lightweight renderer made for low-end PCs and integrated graphics. Much less GPU load than DirectX 11/12, simpler visuals. Change it in Fortnite: Settings > Video > Advanced Graphics > Rendering Mode > Performance (restart required). ConstiBoost does not switch the rendering mode for you." />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,6,12">
                    <StackPanel>
                        <TextBlock Text="VSync" Style="{StaticResource Text.H3}" />
                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0"
                                   Text="Synchronizes frames with your monitor to avoid tearing, but adds input lag. If FPS fall below the refresh rate, VSync can halve them. Recommended: OFF, plus an FPS cap for even frame pacing." />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,6,12">
                    <StackPanel>
                        <TextBlock Text="Nanite &amp; Lumen" Style="{StaticResource Text.H3}" />
                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0"
                                   Text="Unreal Engine 5 features for detailed geometry (Nanite) and realistic lighting (Lumen). Very demanding – only available in DirectX 12. They are off in Performance Mode and with Global Illumination/Reflections on Low. In DirectX 12 set 'Nanite Virtualized Geometry' to Off in-game." />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,6,12">
                    <StackPanel>
                        <TextBlock Text="NVIDIA Reflex" Style="{StaticResource Text.H3}" />
                        <TextBlock Text="{Binding ReflexText}" Style="{StaticResource Text.Body}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Process + cache -->
            <Grid Margin="0,4,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="PROCESS PRIORITY (OPTIONAL)" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="{Binding ProcessText}" Style="{StaticResource Text.Value}" Margin="0,10,0,0" TextWrapping="Wrap" TextTrimming="None" />
                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,8,0,0"
                                   Text="Sets Fortnite to 'Above normal' (never High/Realtime). Resets automatically when Fortnite closes. Fortnite's anti-cheat may block the change – that is expected and safe." />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Content="SET ABOVE NORMAL" Command="{Binding RaisePriorityCommand}" Margin="0,0,10,0" />
                            <Button Style="{StaticResource SecondaryButton}" Content="RESET" Command="{Binding ResetPriorityCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="SHADER CACHE" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="{Binding ShaderCacheText}" Style="{StaticResource Text.Big}" FontSize="26" Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0"
                                   Text="DirectX and GPU driver caches used by Fortnite. Clearing helps after driver updates or permanent stutter; the first match afterwards compiles shaders again." />
                        <Button Style="{StaticResource SecondaryButton}" Content="CLEAR SHADER CACHE" Command="{Binding ClearShaderCacheCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Background apps -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Content="FIND APPS" Command="{Binding LoadAppsCommand}" Margin="0,0,10,0" />
                            <Button Style="{StaticResource AccentButton}" Content="CLOSE SELECTED" Command="{Binding CloseAppsCommand}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="CLOSE BACKGROUND APPS" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="Free RAM and CPU before a match. Windows, drivers, security and anti-cheat are never listed." Style="{StaticResource Text.Body}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding BackgroundApps}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,0,6" Padding="12,8">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding RamText}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                        <CheckBox IsChecked="{Binding IsSelected}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Body}" FontSize="11.5" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ContentControl Content="{Binding GamingMode}" ContentTemplate="{StaticResource GamingModeCard}" Focusable="False" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
