<UserControl x:Class="ConstiBoost.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ConstiBoost.Views"
             xmlns:ui="clr-namespace:ConstiBoost.UI"
             x:Name="Root">
    <UserControl.Resources>
        <!-- Expanded game -->
        <DataTemplate x:Key="GameDetail">
            <StackPanel Margin="0,16,0,0">
                <!-- Actions -->
                <WrapPanel>
                    <Button Style="{StaticResource AccentButton}" Content="▶ PLAY" Command="{Binding LaunchCommand}" Margin="0,0,10,8" />
                    <Button Command="{Binding FocusCommand}" Margin="0,0,10,8">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BadSoftBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource BadBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BadBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding FocusButtonText}" />
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Content="OPEN FOLDER" Command="{Binding OpenFolderCommand}" Margin="0,0,10,8" />
                    <Button Style="{StaticResource DangerButton}" Content="UNINSTALL" Command="{Binding UninstallCommand}" Margin="0,0,10,8"
                            Visibility="{Binding Game.CanUninstall, Converter={StaticResource BoolToVis}}" />
                </WrapPanel>
                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0">
                    <Run Text="{Binding Game.InstallPath, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Game.MainExecutable, Mode=OneWay}" />
                </TextBlock>

                <!-- Browser Performance Launch -->
                <Border Style="{StaticResource InnerCard}" Padding="18" Margin="0,16,0,0" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                        Visibility="{Binding CanPerformanceLaunch, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="⚡ PERFORMANCE LAUNCH" Command="{Binding PerformanceLaunchCommand}" VerticalAlignment="Top" />
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="⚡ PERFORMANCE LAUNCH (AUTOMATIC LOW SETTINGS)" Style="{StaticResource Text.Caption}" />
                                <TextBlock Style="{StaticResource Text.Body}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="Opens the game in its own clean browser window with everything set for FPS automatically: fewer pixels to render (render size), GPU acceleration forced on, no extensions, high-performance GPU, and optionally Game Focus. Your normal browser profile stays untouched – log in to the game once in this window, it is remembered." />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Margin="0,12,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="Game address" Style="{StaticResource Text.Body}" Width="110" VerticalAlignment="Center" />
                            <TextBox Text="{Binding LaunchUrl, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="13"
                                     Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                     CaretBrush="{DynamicResource TextPrimaryBrush}" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Render size" Style="{StaticResource Text.Body}" Width="110" VerticalAlignment="Center" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="RenderScale" Content="100 %" Padding="10,5" Margin="0,0,6,0" Command="{Binding SelectRenderScaleCommand}" CommandParameter="100" IsChecked="{Binding IsScale100, Mode=OneTime}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="RenderScale" Content="85 %" Padding="10,5" Margin="0,0,6,0" Command="{Binding SelectRenderScaleCommand}" CommandParameter="85" IsChecked="{Binding IsScale85, Mode=OneTime}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="RenderScale" Content="75 % (recommended)" Padding="10,5" Margin="0,0,6,0" Command="{Binding SelectRenderScaleCommand}" CommandParameter="75" IsChecked="{Binding IsScale75, Mode=OneTime}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="RenderScale" Content="60 % (max FPS)" Padding="10,5" Command="{Binding SelectRenderScaleCommand}" CommandParameter="60" IsChecked="{Binding IsScale60, Mode=OneTime}" />
                        </StackPanel>
                        <TextBlock Text="{Binding RenderScaleText}" Style="{StaticResource Text.Caption}" Margin="110,4,0,0" TextWrapping="Wrap" />
                        <CheckBox IsChecked="{Binding LaunchStartsFocus}" Margin="0,10,0,0" Foreground="{DynamicResource TextPrimaryBrush}"
                                  Content="Also start 🎯 Game Focus (close background apps, Max FPS power mode, boost the game tab + browser GPU process)" />
                        <CheckBox IsChecked="{Binding UnlockFps}" Margin="0,6,0,0" Foreground="{DynamicResource TextPrimaryBrush}"
                                  Content="Unlock FPS above the display refresh rate (VSync off – more FPS on the counter, more heat, possible tearing)" />
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="Honest note: the graphics menu inside a website belongs to the website – no external program can switch it. If the game has its own options (quality, shadows, draw distance), set them to the lowest once; they are then remembered in the ConstiBoost browser window." />
                    </StackPanel>
                </Border>

                <!-- Browser game boost -->
                <Border Style="{StaticResource InnerCard}" Padding="18" Margin="0,16,0,0" Visibility="{Binding IsBrowser, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="🌐 BROWSER GAME BOOST" Style="{StaticResource Text.Caption}" />
                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,10" TextWrapping="Wrap"
                                   Text="Web games (WebGL) run inside the browser, so the browser is the game. Honest note: no tool can push FPS far beyond what the web port and your graphics allow – but these steps remove the most common brakes. Use 🎯 FOCUS below, then MEASURE to see the real effect." />
                        <TextBlock Text="1. Hardware acceleration must be ON (without it the CPU renders the game – the #1 cause of lag)" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="16,4,0,0">
                            <TextBlock Text="{Binding AccelerationUrl}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Style="{StaticResource GhostButton}" Content="Copy address" Command="{Binding CopyAccelerationUrlCommand}" Padding="4,2" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="16,2,0,8">
                            <TextBlock Style="{StaticResource Text.Body}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"><Run Text="Check: " /><Run Text="{Binding GpuUrl, Mode=OneWay}" /><Run Text=" → 'WebGL: Hardware accelerated' should be shown" /></TextBlock>
                            <Button Style="{StaticResource GhostButton}" Content="Copy address" Command="{Binding CopyGpuUrlCommand}" Padding="4,2" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Text="2. Close all other tabs and windows – every open tab costs CPU and memory (videos and streams especially)." />
                        <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" Text="3. Play in a smaller window instead of fullscreen: many web games render at window size – a smaller window means fewer pixels and often clearly more FPS on integrated graphics. Ctrl + minus (browser zoom out) can have the same effect." />
                        <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" Text="4. Turn off the browser's energy saver / efficiency mode while playing and keep the laptop plugged in." />
                        <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" Text="5. Lower the game's own graphics options if it has any (resolution, draw distance, shadows)." />
                        <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" Text="6. 🎯 FOCUS ON THIS GAME: closes background apps, Gaming Mode MAX FPS, mutes notifications and gives the game tab and the browser GPU process 'Above normal' priority (other tabs and browsers are not boosted)." />
                        <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding IsFirefox, Converter={StaticResource BoolToVis}}"
                                   Text="Firefox: the automatic Performance Launch is unavailable (needs Chrome, Edge, Brave or Opera). Chromium browsers usually run WebGL games faster on AMD graphics." />
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="Safety: unofficial websites that host commercial games are often unlicensed and full of ads/pop-ups. Don't download or run files from them and don't enter passwords. ConstiBoost never reads browser data (history, cookies, passwords)." />
                    </StackPanel>
                </Border>

                <!-- Bottleneck check -->
                <Border Style="{StaticResource InnerCard}" Padding="18" Margin="0,16,0,0">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="🔍 ANALYZE (12 s)" Command="{Binding AnalyzeBottleneckCommand}" VerticalAlignment="Top" />
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="🔍 WHY IS MY GPU NOT AT 100 %?" Style="{StaticResource Text.Caption}" />
                                <TextBlock Style="{StaticResource Text.Body}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="Start the game, click ANALYZE and keep playing for 12 seconds. ConstiBoost measures the real load of every CPU thread, the GPU, temperature and clock and tells you what limits your FPS – and what actually helps. Read-only, nothing is changed." />
                            </StackPanel>
                        </DockPanel>
                        <ProgressBar IsIndeterminate="True" Margin="0,8,0,0" Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding BottleneckStatus}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding BottleneckStatus, Converter={StaticResource NullToVis}}" />
                        <ItemsControl ItemsSource="{Binding Bottleneck.Findings}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="12" Margin="0,6,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="{Binding Explanation}" Style="{StaticResource Text.Body}" Margin="0,4,0,6" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding Fixes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StringFormat='→ {0}'}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Real FPS measurement -->
                <Border Style="{StaticResource InnerCard}" Padding="18" Margin="0,16,0,0">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Style="{StaticResource AccentButton}" Content="📏 MEASURE 60 s" Command="{Binding MeasureCommand}" CommandParameter="60" Margin="0,0,8,0" />
                                <Button Style="{StaticResource SecondaryButton}" Content="120 s" Command="{Binding MeasureCommand}" CommandParameter="120" Margin="0,0,8,0" />
                                <Button Style="{StaticResource GhostButton}" Content="Cancel" Command="{Binding CancelMeasureCommand}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="📏 REAL FPS MEASUREMENT" Style="{StaticResource Text.Caption}" />
                                <TextBlock Style="{StaticResource Text.Body}" FontSize="12" Margin="0,4,12,0" TextWrapping="Wrap"
                                           Text="Measured from Windows' own DirectX frame events (like PresentMon) – no injection, anti-cheat safe. Needs one UAC prompt. DirectX games only (OpenGL/Vulkan not yet)." />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Setting used while measuring:" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ItemsControl ItemsSource="{Binding PresetNames}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="MeasuredPreset" Content="{Binding}" Padding="10,5" Margin="0,0,6,4"
                                                     Command="{Binding DataContext.SelectMeasuredPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock Text="{Binding MeasuredPreset, StringFormat='Selected: {0}'}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding MeasureText}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0" Visibility="{Binding MeasureText, Converter={StaticResource NullToVis}}" />
                        <ProgressBar IsIndeterminate="True" Margin="0,6,0,0" Visibility="{Binding IsMeasuring, Converter={StaticResource BoolToVis}}" />
                        <Grid Margin="0,12,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>
                            <UniformGrid Columns="5">
                                <StackPanel><TextBlock Text="AVG FPS" Style="{StaticResource Text.Caption}" /><TextBlock Text="{Binding ResultAvg}" Style="{StaticResource Text.Big}" FontSize="28" Foreground="{DynamicResource AccentBrush}" /></StackPanel>
                                <StackPanel><TextBlock Text="1 % LOW" Style="{StaticResource Text.Caption}" /><TextBlock Text="{Binding ResultLow1}" Style="{StaticResource Text.Big}" FontSize="28" /></StackPanel>
                                <StackPanel><TextBlock Text="0.1 % LOW" Style="{StaticResource Text.Caption}" /><TextBlock Text="{Binding ResultLow01}" Style="{StaticResource Text.Big}" FontSize="28" /></StackPanel>
                                <StackPanel><TextBlock Text="STUTTERS" Style="{StaticResource Text.Caption}" /><TextBlock Text="{Binding ResultStutters}" Style="{StaticResource Text.Big}" FontSize="28" /></StackPanel>
                                <StackPanel><TextBlock Text="FRAME TIME" Style="{StaticResource Text.Caption}" /><TextBlock Text="{Binding ResultFrameTime}" Style="{StaticResource Text.Value}" Margin="0,8,0,0" /></StackPanel>
                            </UniformGrid>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="FPS PER SECOND" Style="{StaticResource Text.Caption}" />
                                <ui:SparklineChart Height="70" Margin="0,6,0,0" Values="{Binding ResultChart}" Maximum="{Binding ResultChartMax}" Capacity="120" Stroke="{DynamicResource ChartRamBrush}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding CompareText}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding CompareText, Converter={StaticResource NullToVis}}" />
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding History, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="HISTORY" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="70" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource Text.Body}" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding Setting}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Profile}" Style="{StaticResource Text.Body}" FontSize="12" />
                                            <TextBlock Grid.Column="3" Text="{Binding FpsText}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Grid.Column="4" Text="{Binding LowText, StringFormat='1% {0}'}" Style="{StaticResource Text.Body}" FontSize="12" />
                                            <TextBlock Grid.Column="5" Text="{Binding TempText}" Style="{StaticResource Text.Body}" FontSize="12" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Guided FPS Tuner (Fortnite) -->
                <Border Style="{StaticResource InnerCard}" Padding="18" Margin="0,16,0,0" Visibility="{Binding IsFortnite, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="🎚️ GUIDED FPS TUNER" Style="{StaticResource Text.Caption}" />
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TargetFps, StringFormat='{}{0} FPS'}" Width="70" TextAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
                            <TextBlock DockPanel.Dock="Left" Text="Target" Style="{StaticResource Text.Body}" Width="60" VerticalAlignment="Center" />
                            <Slider Minimum="30" Maximum="240" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding TargetFps}" />
                        </DockPanel>
                        <TextBlock Text="{Binding TunerAdvice}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <Button Style="{StaticResource AccentButton}" Content="{Binding TunerActionText}" Command="{Binding ApplyTunerStepCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Visibility="{Binding HasTunerAction, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" Text="Loop: measure → apply one step → play the same situation → measure again. Every step is backed up." />
                    </StackPanel>
                </Border>

                <!-- Game settings editor -->
                <Border Style="{StaticResource InnerCard}" Padding="18" Margin="0,16,0,0" Visibility="{Binding HasEditor, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding EditorTitle, StringFormat='⚙️ {0}'}" Style="{StaticResource Text.Caption}" />
                        <ItemsControl ItemsSource="{Binding EditorValues}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,10,8">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Value}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding EditorPresets}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" ToolTip="{Binding Description}"
                                            Command="{Binding DataContext.ApplyEditorPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding Name}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <CheckBox IsChecked="{Binding EditorCapFps}" Margin="0,4,0,0">
                            <TextBlock Text="{Binding FpsCap, StringFormat='Also cap FPS at {0} (if the game supports it in this file)'}" />
                        </CheckBox>
                        <TextBlock Text="{Binding EditorFile}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- FPS estimate -->
                    <Border Style="{StaticResource InnerCard}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="📈 FPS ESTIMATE" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="{Binding EstimateHeader}" Style="{StaticResource Text.H3}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CalibrationText}" Style="{StaticResource Text.Body}" FontSize="12" Foreground="{DynamicResource GoodBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding CalibrationText, Converter={StaticResource NullToVis}}" />
                            <TextBlock Text="{Binding CurrentSetting}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"
                                       Visibility="{Binding CurrentSetting, Converter={StaticResource NullToVis}}" />
                            <StackPanel Visibility="{Binding HasEstimate, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding Resolutions}" Margin="0,12,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,6,6" Content="{Binding Label}"
                                                    Command="{Binding DataContext.SelectResolutionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Scale, StringFormat='{}{0} %'}" Width="50" TextAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                    <TextBlock DockPanel.Dock="Left" Text="Render scale" Style="{StaticResource Text.Body}" Width="100" VerticalAlignment="Center" />
                                    <Slider Minimum="50" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Scale}" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,8"><Run Text="Resolution: " /><Run Text="{Binding Resolution.Label, Mode=OneWay}" /></TextBlock>
                                <ItemsControl ItemsSource="{Binding Estimates}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="10,7" Margin="0,0,0,4" Background="{DynamicResource CardBrush}">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding RangeText}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AccentBrush}" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Setting}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                        <Border Style="{StaticResource Pill}" Margin="8,0,0,0" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="YOUR SETTING" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                        </Border>
                                                        <TextBlock Text="  · above display refresh" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                                                   Visibility="{Binding AboveRefresh, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="WHAT THE ESTIMATE IS BASED ON" Style="{StaticResource Text.Caption}" Margin="0,10,0,4" />
                                <ItemsControl ItemsSource="{Binding Factors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource Text.Body}" FontSize="12"><Run Text="{Binding Key, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" /><Run Text=": " /><Run Text="{Binding Value, Mode=OneWay}" /></TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="Estimate – not a measurement. Based on typical results of comparable hardware in average scenes. Real FPS vary with map, scene, drivers, game updates and temperature." />
                            </StackPanel>
                            <TextBlock Text="{Binding Tip, StringFormat='💡 {0}'}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Focus -->
                    <Border Grid.Column="2" Style="{StaticResource InnerCard}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="🎯 GAME FOCUS" Style="{StaticResource Text.Caption}" />
                            <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,10"
                                       Text="Puts every safe system resource behind this game. All changes are reversible with STOP FOCUS." />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton Style="{StaticResource Segment}" GroupName="FocusProfile" Content="MAX FPS" IsChecked="{Binding IsMaxFps}" Padding="12,7" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="FocusProfile" Content="BALANCED" IsChecked="{Binding IsBalanced}" Padding="12,7" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="FocusProfile" Content="COOL" IsChecked="{Binding IsCool}" Padding="12,7" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoFocusEnabled}" Margin="0,0,0,12"
                                      ToolTip="Saves the options below. When the game starts, Focus starts automatically; when it closes, everything is restored. ConstiBoost must be running (tray).">
                                <TextBlock Text="Auto-Focus when this game starts" FontWeight="SemiBold" />
                            </CheckBox>
                            <CheckBox Content="Game priority 'Above normal' while running" IsChecked="{Binding BoostPriority}" Margin="0,0,0,8" />
                            <CheckBox Content="Windows GPU preference: High performance" IsChecked="{Binding GpuPreference}" Margin="0,0,0,8"
                                      ToolTip="Settings > System > Display > Graphics. Matters on PCs with two GPUs; harmless on integrated-only systems." />
                            <CheckBox Content="Mute notification banners" IsChecked="{Binding MuteNotifications}" Margin="0,0,0,8" />
                            <CheckBox Content="Lower priority of browsers/launchers" IsChecked="{Binding LowerPriority}" Margin="0,0,0,8" />
                            <CheckBox IsChecked="{Binding CapFps}" Margin="0,0,0,8" Visibility="{Binding IsFortnite, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding FpsCap, StringFormat='Cap Fortnite at {0} FPS (less heat)'}" />
                            </CheckBox>
                            <TextBlock Text="CLOSE WHILE PLAYING" Style="{StaticResource Text.Caption}" Margin="0,8,0,6" />
                            <ItemsControl ItemsSource="{Binding Apps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding RamText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                            <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding DisplayName}" ToolTip="{Binding Hint}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Fortnite tools -->
                <Expander Margin="0,16,0,0" Visibility="{Binding IsFortnite, Converter={StaticResource BoolToVis}}">
                    <Expander.Header>
                        <TextBlock Text="Fortnite Tools – presets, current config, shader cache, process priority" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                    </Expander.Header>
                    <views:FortniteView DataContext="{Binding Fortnite}" Margin="0,12,0,0" />
                </Expander>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="0,0,0,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Content="RESCAN" Command="{Binding RescanCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="🎮 Games" Style="{StaticResource Text.H1}" />
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Body}" />
                <TextBlock Text="{Binding FocusText}" Style="{StaticResource Text.H3}" Foreground="{DynamicResource GoodBrush}" Visibility="{Binding FocusText, Converter={StaticResource NullToVis}}" />
            </StackPanel>
        </DockPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                <TextBlock Text="Sort:" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Style="{StaticResource SecondaryButton}" Content="Last played" Command="{Binding SortCommand}" CommandParameter="LastPlayed" Padding="12,7" Margin="0,0,6,0" />
                <Button Style="{StaticResource SecondaryButton}" Content="A–Z" Command="{Binding SortCommand}" CommandParameter="Name" Padding="12,7" Margin="0,0,6,0" />
                <Button Style="{StaticResource SecondaryButton}" Content="Size" Command="{Binding SortCommand}" CommandParameter="Size" Padding="12,7" />
            </StackPanel>
            <Border Background="{DynamicResource InputBrush}" CornerRadius="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="12,0">
                <DockPanel>
                    <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFont}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource AccentBrush}" VerticalContentAlignment="Center" Height="36" FontSize="13" />
                </DockPanel>
            </Border>
        </DockPanel>

        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Margin="0,0,0,12" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Visibility="{Binding Games, Converter={StaticResource InvNullToVis}}">
                    <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                               Text="No games found. ConstiBoost reads Steam libraries, Epic Games Launcher manifests and Windows app entries of game publishers (GOG, EA, Ubisoft, Riot, Battle.net, Rockstar, Roblox …). Microsoft Store / Xbox app games are not listed yet." />
                </Border>
                <ItemsControl ItemsSource="{Binding GamesView}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" Padding="16">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Button Command="{Binding DataContext.ToggleCommand, ElementName=Root}" CommandParameter="{Binding}" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid Background="Transparent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
                                                        <TextBlock Text="{Binding Initials}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H3}" FontSize="15.5" />
                                                            <Border Style="{StaticResource Pill}" Margin="10,0,0,0" Background="{DynamicResource GoodSoftBrush}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="RUNNING" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource GoodBrush}" />
                                                            </Border>
                                                            <Border Style="{StaticResource Pill}" Margin="6,0,0,0" Visibility="{Binding IsFocused, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="🎯 FOCUS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Style="{StaticResource Text.Body}" FontSize="12" Margin="0,3,0,0">
                                                            <Run Text="{Binding SourceText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding LastPlayedText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding SizeText, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock x:Name="Chevron" Grid.Column="2" Text="&#xE70D;" FontFamily="{DynamicResource IconFont}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
                                                        <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <ContentControl Content="{Binding DataContext.Detail, ElementName=Root}" ContentTemplate="{StaticResource GameDetail}" Focusable="False"
                                                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
