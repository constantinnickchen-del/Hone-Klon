<UserControl x:Class="ConstiBoost.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ConstiBoost.UI">
    <DockPanel Margin="0,0,0,24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Hardware" Style="{StaticResource Text.H1}" />
            <TextBlock Text="Live monitor, processes, network and benchmark. Monitoring only runs while a tab is visible." Style="{StaticResource Text.Body}" />
        </StackPanel>

        <TabControl SelectedIndex="{Binding SelectedTab}">
            <!-- ========== Monitor ========== -->
            <TabItem Header="Monitor">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <UniformGrid Columns="3" Margin="-8,0,-8,16">
                            <Border Style="{StaticResource Card}" Margin="8,0">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CpuNow}" Style="{StaticResource Text.Big}" FontSize="26" />
                                        <TextBlock Text="CPU USAGE" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ui:SparklineChart Height="110" Margin="0,12,0,0" Values="{Binding CpuHistory}" Stroke="{DynamicResource ChartCpuBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="8,0">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding GpuNow}" Style="{StaticResource Text.Big}" FontSize="26" />
                                        <TextBlock Text="GPU USAGE" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ui:SparklineChart Height="110" Margin="0,12,0,0" Values="{Binding GpuHistory}" Stroke="{DynamicResource ChartGpuBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="8,0">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding RamNow}" Style="{StaticResource Text.Big}" FontSize="26" />
                                        <StackPanel>
                                            <TextBlock Text="RAM USAGE" Style="{StaticResource Text.Caption}" />
                                            <TextBlock Text="{Binding RamDetail}" Style="{StaticResource Text.Body}" FontSize="11" />
                                        </StackPanel>
                                    </DockPanel>
                                    <ui:SparklineChart Height="110" Margin="0,12,0,0" Values="{Binding RamHistory}" Stroke="{DynamicResource ChartRamBrush}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <UniformGrid Columns="3" Margin="-8,0,-8,16">
                            <Border Style="{StaticResource Card}" Margin="8,0">
                                <StackPanel>
                                    <TextBlock Text="CPU TEMPERATURE" Style="{StaticResource Text.Caption}" />
                                    <TextBlock Text="{Binding CpuTempNow}" Style="{StaticResource Text.Value}" Margin="0,8,0,0" />
                                    <TextBlock Text="Read from HWiNFO / LibreHardwareMonitor if running – ConstiBoost installs no drivers." Style="{StaticResource Text.Body}" FontSize="11.5" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="8,0">
                                <StackPanel>
                                    <TextBlock Text="GPU TEMPERATURE" Style="{StaticResource Text.Caption}" />
                                    <TextBlock Text="{Binding GpuTempNow}" Style="{StaticResource Text.Value}" Margin="0,8,0,0" />
                                    <TextBlock Text="Integrated GPUs share the CPU package sensor; no supported source." Style="{StaticResource Text.Body}" FontSize="11.5" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="8,0">
                                <StackPanel>
                                    <TextBlock Text="ACPI THERMAL ZONE" Style="{StaticResource Text.Caption}" />
                                    <TextBlock Text="{Binding ThermalNow}" Style="{StaticResource Text.Value}" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding ThermalZone}" Style="{StaticResource Text.Body}" FontSize="11.5" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="FPS" Style="{StaticResource Text.Caption}" />
                                <TextBlock Text="{Binding FpsText}" Style="{StaticResource Text.Body}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="SYSTEM DETAILS" Style="{StaticResource Text.Caption}" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding Details}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Key}" Style="{StaticResource Text.Body}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="DRIVES" Style="{StaticResource Text.Caption}" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding Drives}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,4,0,10">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Text.Body}" FontSize="12" />
                                                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold">
                                                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Label, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </DockPanel>
                                                    <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Margin="0,6,0,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========== Processes ========== -->
            <TabItem Header="Processes">
                <DockPanel DataContext="{Binding Processes}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="CLOSE PROCESS" Command="{Binding CloseCommand}" />
                        <StackPanel>
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Body}" />
                            <TextBlock Style="{StaticResource Text.Body}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"
                                       Text="Protected = critical Windows/security process (never closed). Caution = closing has side effects (e.g. explorer.exe). Click a column header to sort." />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Card}" Padding="8">
                        <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" VirtualizingPanel.IsVirtualizing="True" EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PROCESS" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80" />
                                <DataGridTextColumn Header="CPU %" Binding="{Binding CpuText}" SortMemberPath="Cpu" Width="90" />
                                <DataGridTextColumn Header="RAM" Binding="{Binding RamText}" SortMemberPath="Ram" Width="100" />
                                <DataGridTextColumn Header="GPU %" Binding="{Binding GpuText}" SortMemberPath="GpuSort" Width="90" />
                                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="120" />
                                <DataGridTextColumn Header="SAFETY" Binding="{Binding ProtectionText}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- ========== Network ========== -->
            <TabItem Header="Network">
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Network}">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="REFRESH" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Text="CONNECTION" Style="{StaticResource Text.Caption}" />
                                    <TextBlock Text="{Binding PrimaryName}" Style="{StaticResource Text.H2}" Margin="0,6,0,2" />
                                    <TextBlock Text="{Binding PrimaryDetails}" Style="{StaticResource Text.Body}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <UniformGrid Columns="4" Margin="-8,0,-8,16">
                            <Border Style="{StaticResource Card}" Margin="8,0">
                                <StackPanel>
                                    <TextBlock Text="LIVE DOWNLOAD" Style="{StaticResource Text.Caption}" />
                                    <TextBlock Text="{Binding LiveDown}" Style="{StaticResource Text.Big}" FontSize="22" Margin="0,8,0,0" />
                                    <TextBlock Text="current traffic" Style="{StaticResource Text.Body}" FontSize="11" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="8,0">
                                <StackPanel>
                                    <TextBlock Text="LIVE UPLOAD" Style="{StaticResource Text.Caption}" />
                                    <TextBlock Text="{Binding LiveUp}" Style="{StaticResource Text.Big}" FontSize="22" Margin="0,8,0,0" />
                                    <TextBlock Text="current traffic" Style="{StaticResource Text.Body}" FontSize="11" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="8,0">
                                <StackPanel>
                                    <TextBlock Text="DOWNLOAD (TEST)" Style="{StaticResource Text.Caption}" />
                                    <TextBlock Text="{Binding SpeedDown}" Style="{StaticResource Text.Big}" FontSize="22" Margin="0,8,0,0" />
                                    <TextBlock Text="speed test" Style="{StaticResource Text.Body}" FontSize="11" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="8,0">
                                <StackPanel>
                                    <TextBlock Text="UPLOAD (TEST)" Style="{StaticResource Text.Caption}" />
                                    <TextBlock Text="{Binding SpeedUp}" Style="{StaticResource Text.Big}" FontSize="22" Margin="0,8,0,0" />
                                    <TextBlock Text="speed test" Style="{StaticResource Text.Body}" FontSize="11" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource SecondaryButton}" Content="PING TEST" Command="{Binding PingCommand}" Margin="0,0,10,0" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="DNS TEST" Command="{Binding DnsCommand}" Margin="0,0,10,0" />
                                        <Button Style="{StaticResource AccentButton}" Content="SPEED TEST" Command="{Binding SpeedTestCommand}" />
                                    </StackPanel>
                                    <TextBlock Text="TESTS" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding SpeedStatus}" Style="{StaticResource Text.Body}" Margin="0,8,0,0" Visibility="{Binding SpeedStatus, Converter={StaticResource NullToVis}}" />
                                <ItemsControl ItemsSource="{Binding Pings}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Target, StringFormat='Ping {0}'}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding AverageText}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Grid.Column="2" Text="{Binding JitterText, StringFormat='Jitter {0}'}" Style="{StaticResource Text.Body}" />
                                                <TextBlock Grid.Column="3" Text="{Binding LossText}" Style="{StaticResource Text.Body}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding DnsResults}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="2*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Foreground="{DynamicResource TextPrimaryBrush}">
                                                    <Run Text="DNS " /><Run Text="{Binding Label, Mode=OneWay}" /><Run Text=" (" /><Run Text="{Binding Server, Mode=OneWay}" /><Run Text=")" />
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="PING SERVERS" Command="{Binding ServerPingCommand}" />
                                        <TextBlock Text="🎮 GAME SERVER PING (FORTNITE)" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding ServerPings}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Target}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding AverageText}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding JitterText, StringFormat='Jitter {0}'}" Style="{StaticResource Text.Body}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Text="Uses Epic's public ping endpoints per data center. Choose the region with the lowest ping in Fortnite (Settings > Game > Matchmaking Region). 'Timeout' = the server does not answer pings." />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="TEST" Command="{Binding BufferbloatCommand}" />
                                        <TextBlock Text="📶 LATENCY UNDER LOAD (BUFFERBLOAT)" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding BloatGrade}" Style="{StaticResource Text.Big}" Margin="0,8,0,0" Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="{Binding BloatText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding HasWifi, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="📡 WI-FI QUALITY" Style="{StaticResource Text.Caption}" />
                                <UniformGrid Columns="5" Margin="0,10,0,0">
                                    <StackPanel><TextBlock Text="Signal" Style="{StaticResource Text.Body}" /><TextBlock Text="{Binding Wifi.SignalPercent, StringFormat='{}{0} %'}" Style="{StaticResource Text.Value}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Band" Style="{StaticResource Text.Body}" /><TextBlock Text="{Binding Wifi.Band}" Style="{StaticResource Text.Value}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Channel" Style="{StaticResource Text.Body}" /><TextBlock Text="{Binding Wifi.Channel}" Style="{StaticResource Text.Value}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Standard" Style="{StaticResource Text.Body}" /><TextBlock Text="{Binding Wifi.RadioType}" Style="{StaticResource Text.Value}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Link (down/up)" Style="{StaticResource Text.Body}" /><TextBlock Style="{StaticResource Text.Value}"><Run Text="{Binding Wifi.ReceiveRate, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding Wifi.TransmitRate, Mode=OneWay}" /></TextBlock></StackPanel>
                                </UniformGrid>
                                <ItemsControl ItemsSource="{Binding Wifi.Tips}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='• {0}'}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource InnerCard}">
                            <TextBlock Style="{StaticResource Text.Body}" FontSize="12"
                                       Text="Honest note: no registry tweak reliably lowers your ping – ping depends on your connection, Wi-Fi signal and the server distance. For lower ping use a LAN cable and close downloads/streams. The DNS test only measures; ConstiBoost never changes your DNS settings. If a different DNS is faster, you can set it yourself in Windows Settings > Network." />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========== Benchmark ========== -->
            <TabItem Header="Benchmark">
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Benchmark}">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="System Performance Benchmark" Style="{StaticResource Text.H2}" />
                                <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0"
                                           Text="Measures CPU (single/multi-thread), memory bandwidth, background load and scheduling jitter on this PC (~15 seconds). This is NOT a Fortnite FPS benchmark – it shows whether your system got faster or calmer. Run 'Before', optimize, then run 'After'. Differences below ~3 % are normal measurement noise. Close other apps for consistent results." />
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Style="{StaticResource SecondaryButton}" Content="RUN BEFORE" Command="{Binding RunBeforeCommand}" Margin="0,0,10,0" />
                                    <Button Style="{StaticResource AccentButton}" Content="RUN AFTER" Command="{Binding RunAfterCommand}" Margin="0,0,10,0" />
                                    <Button Style="{StaticResource GhostButton}" Content="Clear history" Command="{Binding ClearCommand}" />
                                </StackPanel>
                                <StackPanel Margin="0,14,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Step}" Style="{StaticResource Text.Body}" />
                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,8,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="3" Margin="-8,0,-8,16">
                            <Border Style="{StaticResource Card}" Margin="8,0">
                                <StackPanel>
                                    <TextBlock Text="BEFORE" Style="{StaticResource Text.Caption}" />
                                    <TextBlock Text="{Binding BeforeScore}" Style="{StaticResource Text.Big}" Margin="0,6,0,0" />
                                    <TextBlock Text="Performance Score" Style="{StaticResource Text.Body}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="8,0">
                                <StackPanel>
                                    <TextBlock Text="AFTER" Style="{StaticResource Text.Caption}" />
                                    <TextBlock Text="{Binding AfterScore}" Style="{StaticResource Text.Big}" Margin="0,6,0,0" />
                                    <TextBlock Text="Performance Score" Style="{StaticResource Text.Body}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="8,0">
                                <StackPanel>
                                    <TextBlock Text="DIFFERENCE" Style="{StaticResource Text.Caption}" />
                                    <TextBlock Text="{Binding ScoreDifference}" Style="{StaticResource Text.Big}" FontSize="26" Margin="0,10,0,0" Foreground="{DynamicResource AccentBrush}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource Card}" Padding="8" Visibility="{Binding Comparison, Converter={StaticResource NullToVis}}">
                            <ItemsControl ItemsSource="{Binding Comparison}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="1.5*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Metric}" Style="{StaticResource Text.Body}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Before}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding After}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Grid.Column="3" Text="{Binding Difference}" FontWeight="SemiBold" Foreground="{Binding Better, Converter={StaticResource StatusBrush}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
