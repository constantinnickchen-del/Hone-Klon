<Window x:Class="ConstiBoost.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ConstiBoost.Views"
        Title="ConstiBoost" Width="1280" Height="820" MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFont}"
        Icon="/ConstiBoost;component/Resources/ConstiBoost.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,16,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4,0,22">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="&#xE945;" FontFamily="{DynamicResource IconFont}" FontSize="18" Foreground="{DynamicResource OnAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ConstiBoost" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="5" Padding="5,1" Margin="7,2,0,0" VerticalAlignment="Center">
                                <TextBlock Text="PRO" FontSize="9.5" FontWeight="Black" Foreground="{DynamicResource OnAccentBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Performance Suite" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,10"
                            Visibility="{Binding Dashboard.GamingMode.IsActive, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource GoodBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Gaming Mode ACTIVE" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource GoodBrush}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding AdminText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0" TextWrapping="Wrap" />
                    <TextBlock Text="v2.0 PRO · 100 % local" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="8,4,0,0" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Pages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="{Binding Icon}" Content="{Binding Title}"
                                         IsChecked="{Binding IsNavigationChecked, Mode=OneWay}"
                                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                         CommandParameter="{Binding Key}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ContentControl x:Name="PageHost" Grid.Row="1" Margin="32,0,32,0"
                            Content="{Binding CurrentPage, NotifyOnTargetUpdated=True}" TargetUpdated="PageHost_TargetUpdated"
                            Focusable="False">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="PageShift" />
                </ContentControl.RenderTransform>
            </ContentControl>
        </Grid>

        <!-- Toast -->
        <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28" MaxWidth="480"
                Background="{DynamicResource CardHoverBrush}" BorderBrush="{Binding ToastKind, Converter={StaticResource StatusBrush}}"
                BorderThickness="1" CornerRadius="12" Padding="16,12"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black" />
            </Border.Effect>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="&#xE711;" FontFamily="{DynamicResource IconFont}"
                        FontSize="10" Command="{Binding DismissToastCommand}" Margin="8,0,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding ToastIcon}" FontFamily="{DynamicResource IconFont}" FontSize="16" Margin="0,0,12,0"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ToastMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- First start overlay -->
        <views:WelcomeView Grid.ColumnSpan="2" DataContext="{Binding Welcome}"
                           Visibility="{Binding DataContext.ShowWelcome, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

        <!-- Caption buttons (on top of everything, also above the welcome overlay) -->
        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" />
            <Button Style="{StaticResource TitleBarButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize" />
            <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close" />
        </StackPanel>
    </Grid>
</Window>
