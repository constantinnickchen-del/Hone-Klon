<UserControl x:Class="ConstiBoost.Views.OptimizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,32">
                <DockPanel Margin="0,0,0,20">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButton}" Content="SELECT RECOMMENDED" Command="{Binding SelectRecommendedCommand}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="ANALYZE AGAIN" Command="{Binding AnalyzeCommand}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource AccentButton}" Content="APPLY OPTIMIZATIONS" Command="{Binding ApplyCommand}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Windows Optimizer" Style="{StaticResource Text.H1}" />
                        <TextBlock Text="Every change shows its current state, the recommendation and the reason. A backup is created before anything is changed." Style="{StaticResource Text.Body}" />
                    </StackPanel>
                </DockPanel>

                <!-- Flow status -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16" BorderBrush="{DynamicResource AccentBrush}">
                    <StackPanel>
                        <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.H3}" />
                            <ProgressBar IsIndeterminate="True" Margin="0,10,0,0" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource InvBoolToVis}}">
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.H3}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ScoreChangeText}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,6,0,0"
                                       Visibility="{Binding ScoreChangeText, Converter={StaticResource NullToVis}}" />
                            <ItemsControl ItemsSource="{Binding Results}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Found}" Margin="0,8,0,0" Visibility="{Binding IsReview, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource IconFont}" Foreground="{DynamicResource AccentBrush}" Margin="0,2,10,0" />
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Optimizations" Style="{StaticResource SectionTitle}" />
                <ItemsControl ItemsSource="{Binding Optimizations}" ItemTemplate="{StaticResource OptimizationCard}" />

                <!-- Game features explained -->
                <TextBlock Text="Windows gaming features" Style="{StaticResource SectionTitle}" />
                <UniformGrid Columns="3" Margin="-6,0">
                    <Border Style="{StaticResource Card}" Margin="6,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding GameModeState}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="Game Mode" Style="{StaticResource Text.H3}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Text.Body}" Margin="0,8,0,0" Text="What: gives the active game priority and blocks driver installs / restart prompts during play." />
                            <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0" Text="Downside: background apps (e.g. a stream encoder) may get less CPU time." />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding GameBarState}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="Xbox Game Bar" Style="{StaticResource Text.H3}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Text.Body}" Margin="0,8,0,0" Text="What: overlay (Win+G) with widgets, captures and performance stats. Captures/background recording cost performance; the overlay itself only runs when opened." />
                            <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0" Text="{Binding GameBarControllerState, Converter={StaticResource Tr}, ConverterParameter='Controller button opens Game Bar: {0}'}" />
                            <Button Style="{StaticResource GhostButton}" Content="Open Game Bar settings" Command="{Binding OpenGameBarSettingsCommand}" HorizontalAlignment="Left" Padding="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding HagsState}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="HW-accelerated GPU scheduling" Style="{StaticResource Text.H3}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Text.Body}" Margin="0,8,0,0" Text="What: the GPU schedules its own work queue. Can lower latency slightly." />
                            <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0" Text="Downside: driver-dependent – may cause stutter on some systems. Needs a restart. 'Unavailable' = not supported by your driver." />
                            <Button Style="{StaticResource GhostButton}" Content="Open graphics settings" Command="{Binding OpenGraphicsSettingsCommand}" HorizontalAlignment="Left" Padding="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Text="Windows Gaming Services (status only)" Style="{StaticResource SectionTitle}" Margin="0,20,0,12" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,0,10"
                                   Text="These services are only needed for Microsoft Store / Xbox games and controllers. Fortnite (Epic) does not need them. ConstiBoost does not disable services." />
                        <ItemsControl ItemsSource="{Binding GamingServices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Purpose}" Style="{StaticResource Text.Body}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Status}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
